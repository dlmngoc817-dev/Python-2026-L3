   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = np.linspace(-5, 5, 25)\n",
    "y = 2*x + np.sin(x)**2 + 3\n",
    "\n",
    "plt.plot(x, y, marker=\"*\")\n",
    "plt.grid(True)\n",
    "plt.title(\"hello, po!\")\n",
    "\n",
    "plt.xlabel(\"x\"); plt.ylabel(\"y\")\n",
    "plt.savefig(\"po.pdf\"); plt.show()"
   ]
  },
